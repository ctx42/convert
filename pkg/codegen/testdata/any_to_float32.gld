Represents a file content generated for conversion from any type to float32.
---
package pkg

import (
	"reflect"
)

// typFloat32 is the [reflect.Type] of float32.
var typFloat32 = reflect.TypeFor[float32]()

// AnyToFloat32 converts the given value to float32
// using the package-level registry.
func AnyToFloat32(value any, opts ...Option) (float32, error) {
	ops := NewOptions(opts...)
	dst := "float32"
	format := "%v: from %T to %v"
	if ops.reg == nil {
		return 0, NewError(ErrNilRegistry, value, dst).Format(format)
	}
	src := reflect.TypeOf(value)
	wrp := ops.reg.lookup(src, typFloat32)
	if wrp == nil {
		return 0, NewError(ErrUnkConv, value, dst).Format(format)
	}
	ret, err := wrp.cst(value)
	if err != nil {
		return 0, err
	}
	return ret.(float32), nil //nolint:forcetypeassert
}
