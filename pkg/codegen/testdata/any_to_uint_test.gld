Represents a file content generated for testing conversion function
from any type to uint.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"net/http"
	"testing"
)

func Test_AnyToUint_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value any
		want  uint
		err   error
		msg   string
	}{
		{"success from float64", 42.0, 42, nil, ""},
		{
			"error - undefined conversion",
			http.Cookie{},
			0,
			ErrUnkConv,
			"conversion undefined: from http.Cookie to uint",
		},
		{
			"error - range",
			-1,
			0,
			ErrInvRange,
			"value out of range: from int to uint",
		},
		{
			"error - fraction",
			4.2,
			0,
			ErrFraction,
			"must be a whole number: from float64 to uint",
		},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := AnyToUint(tc.value)

			// --- Then ---
			if tc.err == nil {
				assert.NoError(t, err)
				assert.Equal(t, tc.want, have)
				return
			}

			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, uint(0), have)
		})
	}
}
