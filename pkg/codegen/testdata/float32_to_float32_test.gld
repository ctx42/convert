Represents a file content generated for testing conversion function
from float32 to float32.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"testing"
)

func Test_Float32ToFloat32_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value float32
		want  float32
	}{
		{"min", Float32SafeIntMin, Float32SafeIntMin},
		{"max", Float32SafeIntMax, Float32SafeIntMax},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Float32ToFloat32(tc.value)

			// --- Then ---
			assert.NoError(t, err)
			assert.Equal(t, tc.want, have)
			assert.Equal(t, tc.value, float32(have))
		})
	}
}
