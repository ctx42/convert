Represents a file content generated for testing conversion function
from float32 to int64.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"math"
	"testing"
)

func Test_Float32ToInt64_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value float32
		want  int64
		err   error
		msg   string
	}{
		{
			"error - must be a number",
			float32(math.NaN()),
			0,
			ErrInvValue,
			"invalid value: from float32 to int64",
		},
		{
			"error - negative infinity",
			float32(math.Inf(-1)),
			0,
			ErrInvValue,
			"invalid value: from float32 to int64",
		},
		{
			"error - positive infinity",
			float32(math.Inf(1)),
			0,
			ErrInvValue,
			"invalid value: from float32 to int64",
		},
		{
			"error - fraction",
			4.2,
			0,
			ErrFraction,
			"must be a whole number: from float32 to int64",
		},
		{
			"error - safe underflow",
			Float32SafeIntMin - 1,
			0,
			ErrInvSafeRange,
			"value out of safe range: from float32 to int64",
		},
		{
			"error - safe overflow",
			Float32SafeIntMax + 1,
			0,
			ErrInvSafeRange,
			"value out of safe range: from float32 to int64",
		},
		{"success", 42, 42, nil, ""},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Float32ToInt64(tc.value)

			// --- Then ---
			if tc.err == nil {
				assert.NoError(t, err)
				assert.Equal(t, tc.want, have)
				assert.Equal(t, tc.value, float32(have))
				return
			}

			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, int64(0), have)
		})
	}
}
