Represents a file content generated for testing conversion function
from float32 to uint16.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"math"
	"testing"
)

func Test_Float32ToUint16_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value float32
		want  uint16
	}{
		{"success", 42, 42},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Float32ToUint16(tc.value)

			// --- Then ---
			assert.NoError(t, err)
			assert.Equal(t, tc.want, have)
			assert.Equal(t, tc.value, float32(have))
		})
	}
}

func Test_Float32ToUint16_error_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value float32
		err   error
		msg   string
	}{
		{
			"error - must be a number",
			float32(math.NaN()),
			ErrInvValue,
			"invalid value: from float32 to uint16",
		},
		{
			"error - negative infinity",
			float32(math.Inf(-1)),
			ErrInvValue,
			"invalid value: from float32 to uint16",
		},
		{
			"error - positive infinity",
			float32(math.Inf(1)),
			ErrInvValue,
			"invalid value: from float32 to uint16",
		},
		{
			"error - fraction",
			4.2,
			ErrFraction,
			"must be a whole number: from float32 to uint16",
		},
		{
			"error - negative",
			-1,
			ErrInvRange,
			"value out of range: from float32 to uint16",
		},
		{
			"error - overflow",
			math.MaxUint16 + 1,
			ErrInvRange,
			"value out of range: from float32 to uint16",
		},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Float32ToUint16(tc.value)

			// --- Then ---
			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, uint16(0), have)
		})
	}
}
