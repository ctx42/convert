Represents a file content generated for testing conversion function
from float64 to float64.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"testing"
)

func Test_Float64ToFloat64_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value float64
		want  float64
		err   error
		msg   string
	}{
		{"min", Float64SafeIntMin, Float64SafeIntMin, nil, ""},
		{"max", Float64SafeIntMax, Float64SafeIntMax, nil, ""},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Float64ToFloat64(tc.value)

			// --- Then ---
			if tc.err == nil {
				assert.NoError(t, err)
				assert.Equal(t, tc.want, have)
				assert.Equal(t, tc.value, float64(have))
				return
			}

			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, float64(0), have)
		})
	}
}
