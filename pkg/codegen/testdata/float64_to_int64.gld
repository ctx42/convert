Represents a file content generated for conversion from float64 to int64.
---
package pkg

import (
	"math"
)

// Float64ToInt64 safely converts float64 value to int64.
func Float64ToInt64(src float64) (dst int64, err error) {
	f64 := src
	if math.IsNaN(f64) {
		return 0, NewError(ErrInvValue, "float64", "int64")
	}
	if math.IsInf(f64, 0) {
		return 0, NewError(ErrInvValue, "float64", "int64")
	}
	if f64 != math.Trunc(f64) {
		return 0, NewError(ErrFraction, "float64", "int64")
	}
	if f64 < Float64SafeIntMin {
		return 0, NewError(ErrInvSafeRange, "float64", "int64")
	}
	if f64 > Float64SafeIntMax {
		return 0, NewError(ErrInvSafeRange, "float64", "int64")
	}
	return int64(src), nil
}
