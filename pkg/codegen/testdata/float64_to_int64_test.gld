Represents a file content generated for testing conversion function
from float64 to int64.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"math"
	"testing"
)

func Test_Float64ToInt64_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value float64
		want  int64
	}{
		{"success", 42, 42},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Float64ToInt64(tc.value)

			// --- Then ---
			assert.NoError(t, err)
			assert.Equal(t, tc.want, have)
			assert.Equal(t, tc.value, float64(have))
		})
	}
}

func Test_Float64ToInt64_error_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value float64
		err   error
		msg   string
	}{
		{
			"error - must be a number",
			math.NaN(),
			ErrInvValue,
			"invalid value: from float64 to int64",
		},
		{
			"error - negative infinity",
			math.Inf(-1),
			ErrInvValue,
			"invalid value: from float64 to int64",
		},
		{
			"error - positive infinity",
			math.Inf(1),
			ErrInvValue,
			"invalid value: from float64 to int64",
		},
		{
			"error - fraction",
			4.2,
			ErrFraction,
			"must be a whole number: from float64 to int64",
		},
		{
			"error - safe underflow",
			Float64SafeIntMin - 1,
			ErrInvSafeRange,
			"value out of safe range: from float64 to int64",
		},
		{
			"error - safe overflow",
			Float64SafeIntMax + 1,
			ErrInvSafeRange,
			"value out of safe range: from float64 to int64",
		},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Float64ToInt64(tc.value)

			// --- Then ---
			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, int64(0), have)
		})
	}
}
