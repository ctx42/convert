Represents a file content generated for testing conversion function
from int32 to float64.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"testing"
)

func Test_Int32ToFloat64_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value int32
		want  float64
		err   error
		msg   string
	}{
		{"success", 42, 42, nil, ""},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Int32ToFloat64(tc.value)

			// --- Then ---
			if tc.err == nil {
				assert.NoError(t, err)
				assert.Equal(t, tc.want, have)
				assert.Equal(t, tc.value, int32(have))
				return
			}

			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, float64(0), have)
		})
	}
}
