Represents a file content generated for conversion from int64 to int.
---
package pkg

import (
	"math"
)

// Int64ToInt safely converts an int64 value to int.
func Int64ToInt(src int64) (dst int, err error) {
	if src < math.MinInt {
		return 0, NewError(ErrInvRange, "int64", "int")
	}
	if src > math.MaxInt {
		return 0, NewError(ErrInvRange, "int64", "int")
	}
	return int(src), nil
}
