Represents a file content generated for testing conversion function
from int64 to int.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"math"
	"strconv"
	"testing"
)

func Test_Int64ToInt_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value int64
		want  int
		err   error
		msg   string
	}{
		{"success", 42, 42, nil, ""},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Int64ToInt(tc.value)

			// --- Then ---
			if tc.err == nil {
				assert.NoError(t, err)
				assert.Equal(t, tc.want, have)
				assert.Equal(t, tc.value, int64(have))
				return
			}

			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, int(0), have)
		})
	}
}

func Test_Int64ToInt_32bit_tabular(t *testing.T) {
	if strconv.IntSize != 32 {
		t.Skip("32-bit platforms only")
	}

	tt := []struct {
		testN string

		value int64
		want  int
		err   error
		msg   string
	}{
		{
			"error - underflow",
			math.MinInt32 - 1,
			0,
			ErrInvRange,
			"value out of range: from int64 to int",
		},
		{
			"error - overflow",
			math.MaxInt32 + 1,
			0,
			ErrInvRange,
			"value out of range: from int64 to int",
		},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Int64ToInt(tc.value)

			// --- Then ---
			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, tc.want, have)
		})
	}
}
