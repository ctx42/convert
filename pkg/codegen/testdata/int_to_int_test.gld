Represents a file content generated for testing conversion function
from int to int.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"math"
	"testing"
)

func Test_IntToInt_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value int
		want  int
	}{
		{"min", math.MinInt, math.MinInt},
		{"max", math.MaxInt, math.MaxInt},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := IntToInt(tc.value)

			// --- Then ---
			assert.NoError(t, err)
			assert.Equal(t, tc.want, have)
			assert.Equal(t, tc.value, int(have))
		})
	}
}
