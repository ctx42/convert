Represents a file content generated for testing conversion function
from uint16 to uint32.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"testing"
)

func Test_Uint16ToUint32_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value uint16
		want  uint32
		err   error
		msg   string
	}{
		{"success", 42, 42, nil, ""},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Uint16ToUint32(tc.value)

			// --- Then ---
			if tc.err == nil {
				assert.NoError(t, err)
				assert.Equal(t, tc.want, have)
				assert.Equal(t, tc.value, uint16(have))
				return
			}

			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, uint32(0), have)
		})
	}
}
