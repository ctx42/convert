Represents a file content generated for testing conversion function
from uint32 to float32.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"testing"
)

func Test_Uint32ToFloat32_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value uint32
		want  float32
		err   error
		msg   string
	}{
		{
			"error - safe overflow",
			Float32SafeIntMax + 1,
			0,
			ErrInvSafeRange,
			"value out of safe range: from uint32 to float32",
		},
		{"success", 42, 42, nil, ""},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Uint32ToFloat32(tc.value)

			// --- Then ---
			if tc.err == nil {
				assert.NoError(t, err)
				assert.Equal(t, tc.want, have)
				assert.Equal(t, tc.value, uint32(have))
				return
			}

			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, float32(0), have)
		})
	}
}
