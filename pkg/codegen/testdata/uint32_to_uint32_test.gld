Represents a file content generated for testing conversion function
from uint32 to uint32.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"math"
	"testing"
)

func Test_Uint32ToUint32_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value uint32
		want  uint32
	}{
		{"min", 0, 0},
		{"max", math.MaxUint32, math.MaxUint32},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Uint32ToUint32(tc.value)

			// --- Then ---
			assert.NoError(t, err)
			assert.Equal(t, tc.want, have)
			assert.Equal(t, tc.value, uint32(have))
		})
	}
}
