Represents a file content generated for conversion from uint64 to float64.
---
package pkg

// Uint64ToFloat64 safely converts uint64 value to float64.
func Uint64ToFloat64(src uint64) (dst float64, err error) {
	if src > Float64SafeIntMax {
		return 0, NewError(ErrInvSafeRange, "uint64", "float64")
	}
	return float64(src), nil
}
