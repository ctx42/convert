Represents a file content generated for testing conversion function
from uint64 to uintptr.
---
package pkg

import (
	"github.com/ctx42/testing/pkg/assert"
	"math"
	"strconv"
	"testing"
)

func Test_Uint64ToUintptr_tabular(t *testing.T) {
	tt := []struct {
		testN string

		value uint64
		want  uintptr
		err   error
		msg   string
	}{
		{"success", 42, 42, nil, ""},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Uint64ToUintptr(tc.value)

			// --- Then ---
			if tc.err == nil {
				assert.NoError(t, err)
				assert.Equal(t, tc.want, have)
				assert.Equal(t, tc.value, uint64(have))
				return
			}

			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, uintptr(0), have)
		})
	}
}

func Test_Uint64ToUintptr_32bit_tabular(t *testing.T) {
	if strconv.IntSize != 32 {
		t.Skip("32-bit platforms only")
	}

	tt := []struct {
		testN string

		value uint64
		want  uintptr
		err   error
		msg   string
	}{
		{
			"error - overflow",
			math.MaxUint32 + 1,
			0,
			ErrInvRange,
			"value out of range: from uint64 to uintptr",
		},
	}

	for _, tc := range tt {
		t.Run(tc.testN, func(t *testing.T) {
			// --- When ---
			have, err := Uint64ToUintptr(tc.value)

			// --- Then ---
			assert.ErrorIs(t, tc.err, err)
			assert.ErrorEqual(t, tc.msg, err)
			assert.Equal(t, tc.want, have)
		})
	}
}
