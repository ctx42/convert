Represents a file content generated for conversion from uint to int64.
---
package pkg

import (
	"math"
)

// UintToInt64 safely converts a uint value to int64.
func UintToInt64(src uint) (dst int64, err error) {
	if uint64(src) > math.MaxInt64 {
		return 0, NewError(ErrInvRange, "uint", "int64")
	}
	return int64(src), nil
}
